# Values below are substituted by ubuntu/24.04/bfb-build before the image is built.
CUSTOM_KERNEL="@CUSTOM_KERNEL@"
CUSTOM_KERNEL_VERSION="@CUSTOM_KERNEL_VERSION@"
OFED_SRC_TARBALL="@OFED_SRC_TARBALL@"
OFED_KERNEL_EXTRA_ARGS='@OFED_KERNEL_EXTRA_ARGS@'
OFED_SOURCES_URL="@OFED_SOURCES_URL@"
OFED_KERNEL_PACKAGES="@OFED_KERNEL_PACKAGES@"
BUILD_SOC_MODULES="@BUILD_SOC_MODULES@"
SOC_SRC_URL="@SOC_SRC_URL@"
SOC_MODULES_SKIP="@SOC_MODULES_SKIP@"

SDIR=/root/workspace

# Build MLNX_OFED under /tmp: create_bfb excludes ./tmp/* from the shipped
# rootfs, so the source tree and build artifacts never reach the BFB.
OFED_BUILD_DIR=${OFED_BUILD_DIR:-/tmp/ofed-rebuild}
SOC_BUILD_DIR=${SOC_BUILD_DIR:-/tmp/soc-rebuild}

# Execute command w/ echo and exit if it fails
ex()
{
	echo "+ $@"
	if ! "$@"; then
		printf "\nFailed executing $@\n\n"
		exit 1
	fi
}

# Pick the kernel the BFB will be built for.
#
# Only consider /lib/modules entries that actually hold a kernel. A
# linux-headers package creates /lib/modules/<ver>/build with no modules, and
# such an entry is often the newest by mtime - picking it silently builds
# everything against a kernel that is not in the image. That is not
# hypothetical: linux-headers-generic arrives as a dependency during the main
# package install.
kernel_candidates=""
for kdir in /lib/modules/*/; do
	kver=`basename "${kdir}"`
	if [ -e "${kdir}/modules.builtin" ] || [ -d "${kdir}/kernel" ] || [ -e "/boot/vmlinuz-${kver}" ]; then
		kernel_candidates="${kernel_candidates} ${kver}"
	fi
done

if [ -n "${CUSTOM_KERNEL_VERSION}" ]; then
	kernel="${CUSTOM_KERNEL_VERSION}"
else
	kernel=""
	for kver in ${kernel_candidates}; do
		if [ -z "${kernel}" ] || [ "/lib/modules/${kver}" -nt "/lib/modules/${kernel}" ]; then
			kernel="${kver}"
		fi
	done
	if [ -z "${kernel}" ]; then
		echo "ERROR: no usable kernel found under /lib/modules."
		echo "Entries present (none contain modules or a matching /boot/vmlinuz):"
		/bin/ls -1 /lib/modules 2>/dev/null | sed -e 's/^/  /'
		exit 1
	fi
fi

if [ "X${CUSTOM_KERNEL}" != "Xyes" ]; then
	/root/workspace/create_bfb -k $kernel
	exit $?
fi

###############################################################################
# Custom kernel build
#
# The Dockerfile installed the customer's kernel .debs instead of the NVIDIA
# BlueField kernel, and pulled doca-runtime-user / doca-devel-user so that no
# prebuilt (kernel-version-pinned) DOCA kernel modules were installed.
#
# MLNX_OFED must now be rebuilt from source against that kernel, one source
# package at a time. kernel-mft ships alongside them and is built by the same
# loop, which is what provides mst_pci, mst_pciconf and bf3_livefish.
#
# The BlueField SoC drivers are then rebuilt from the sources NVIDIA publishes
# for this DOCA release, all of them, regardless of what the kernel already
# carries.
###############################################################################

echo "==============================================================="
echo " Custom kernel BFB build"
echo " kernel          : ${kernel}"
echo " MLNX_OFED source: ${OFED_SRC_TARBALL:-${OFED_SOURCES_URL}}"
echo "==============================================================="

if [ ! -d /lib/modules/${kernel} ]; then
	echo "ERROR: /lib/modules/${kernel} does not exist."
	echo "Kernels present in this image:"
	/bin/ls -1 /lib/modules
	echo "Set CUSTOM_KERNEL_VERSION to select one explicitly."
	exit 1
fi

if [ ! -e /lib/modules/${kernel}/build ]; then
	echo "ERROR: kernel build tree missing: /lib/modules/${kernel}/build"
	echo "MLNX_OFED cannot be compiled without it. Make sure the matching"
	echo "linux-headers .deb is included in CUSTOM_KERNEL_DEBS."
	exit 1
fi

nkernels=`echo ${kernel_candidates} | wc -w`
if [ "$nkernels" != "1" ]; then
	echo "WARNING: more than one kernel is present in /lib/modules:"
	/bin/ls -1 /lib/modules | sed -e 's/^/  /'
	echo "WARNING: usable (non headers-only) candidates:${kernel_candidates}"
	echo "WARNING: building MLNX_OFED against '${kernel}'."
	echo "WARNING: set CUSTOM_KERNEL_VERSION if that is not the intended one."
fi

# MLNX_OFED kernel packages.
#
# Built per source package rather than through install.pl. From DOCA 3.6.0 the
# internal pipeline does the same: each OFED kernel module ships as its own
# <pkg>_<ver>.orig.tar.* under SOURCES/, carrying debian/ packaging, and is
# built directly. That is the same recipe the SoC drivers use here, and it
# does not depend on install.pl continuing to exist.
#
# Order is load bearing. mlnx-ofed-kernel must be built AND installed before
# the rest: iser, isert, srp, mlnx-nvme and mlnx-nfsrdma resolve their headers
# and Module.symvers through /usr/src/ofa_kernel/<arch>/<kernel>, which only
# appears once mlnx-ofed-kernel-modules is installed.
ofed_sources=""

if [ -n "${OFED_SRC_TARBALL}" ] && [ -e "${SDIR}/${OFED_SRC_TARBALL}" ]; then
	mkdir -p ${OFED_BUILD_DIR}
	cd ${OFED_BUILD_DIR}
	ex tar xzf ${SDIR}/${OFED_SRC_TARBALL}
	# MLNX_OFED_SRC-debian-<ver>.tgz extracts to a directory WITHOUT 'debian'
	# in its name, so discover it rather than deriving it from the filename.
	ofed_sources=`/bin/ls -1d ${OFED_BUILD_DIR}/*/SOURCES 2>/dev/null | head -1`
elif [ -n "${OFED_SOURCES_URL}" ]; then
	# A directory of orig tarballs, e.g. an unpacked OFED-internal-debian tree.
	ofed_sources=${OFED_BUILD_DIR}/SOURCES
	mkdir -p ${ofed_sources}
	index=`wget -qO- "${OFED_SOURCES_URL}/" 2>/dev/null`
	for pkg in ${OFED_KERNEL_PACKAGES}; do
		tb=`echo "${index}" | grep -oE "${pkg}_[0-9][A-Za-z0-9._+-]*\.orig\.tar\.[a-z]+" | sort -u | head -1`
		if [ -z "${tb}" ]; then
			echo "ERROR: no source tarball for ${pkg} under ${OFED_SOURCES_URL}/"
			exit 1
		fi
		ex wget -q -P ${ofed_sources} "${OFED_SOURCES_URL}/${tb}"
	done
fi

if [ -z "${ofed_sources}" ] || [ ! -d "${ofed_sources}" ]; then
	echo "ERROR: no MLNX_OFED sources. Provide MLNX_OFED_SRC_URL/_LOCAL (a"
	echo "       MLNX_OFED_SRC-debian-<ver>.tgz) or OFED_SOURCES_URL (a"
	echo "       directory of <pkg>_<ver>.orig.tar.* files)."
	exit 1
fi

echo "MLNX_OFED sources: ${ofed_sources}"

# Unpack and build one source package. Leaves the .deb next to the source dir.
build_ofed_pkg()
{
	pkg=$1
	tb=`/bin/ls -1 ${ofed_sources}/${pkg}_[0-9]*.orig.tar.* 2>/dev/null | head -1`
	if [ -z "${tb}" ]; then
		echo "ERROR: ${pkg} source tarball not found in ${ofed_sources}"
		return 1
	fi
	rm -rf ${OFED_BUILD_DIR}/build/${pkg}
	mkdir -p ${OFED_BUILD_DIR}/build/${pkg}
	tar xf "${tb}" -C ${OFED_BUILD_DIR}/build/${pkg} || return 1
	src=`/bin/ls -1d ${OFED_BUILD_DIR}/build/${pkg}/*/ 2>/dev/null | head -1`
	[ -n "${src}" ] || return 1
	echo "OFED: building ${pkg} for ${kernel}"
	( set -e
	  cd "${src}"
	  # control.no_dkms declares the -modules package; not every source has one.
	  [ -e debian/control.no_dkms ] && cp debian/control.no_dkms debian/control
	  # mlnx-ofed-kernel reads kernelver, the dependent modules read KVER.
	  # DEB_BUILD_PROFILES must be in the environment, not only in -P:
	  # mlnx-ofed-kernel's debian/rules derives WITH_DKMS from it directly,
	  # and a plain '=' assignment in a makefile overrides the environment,
	  # so passing WITH_DKMS=0 alone does not select the modules package.
	  DEB_BUILD_PROFILES=modules WITH_DKMS=0 \
	    kernelver=${kernel} KVER=${kernel} \
	    configure_options="${OFED_KERNEL_EXTRA_ARGS}" \
	    dpkg-buildpackage -us -uc -b -Pmodules )
}

install_ofed_debs()
{
	debs=`find $1 -maxdepth 2 -name '*.deb' ! -name '*dbg*' ! -name '*debuginfo*' 2>/dev/null`
	if [ -z "${debs}" ]; then
		echo "ERROR: $2 produced no .deb packages"
		exit 1
	fi
	echo "Installing ${2}:"
	echo "${debs}" | sed -e 's|.*/|  |'
	dpkg -i --force-overwrite ${debs} || apt install -y -f
	if [ $? -ne 0 ]; then
		echo "ERROR: failed to install ${2}"
		exit 1
	fi
}

# 1. mlnx-ofed-kernel first, and install it so the rest can find ofa_kernel.
if ! build_ofed_pkg mlnx-ofed-kernel; then
	echo "ERROR: failed to build mlnx-ofed-kernel for ${kernel}"
	exit 1
fi
install_ofed_debs ${OFED_BUILD_DIR}/build/mlnx-ofed-kernel "mlnx-ofed-kernel"
ex depmod -a ${kernel}

if [ ! -d /usr/src/ofa_kernel/`uname -m`/${kernel} ]; then
	echo "ERROR: /usr/src/ofa_kernel/`uname -m`/${kernel} was not created by"
	echo "       mlnx-ofed-kernel-modules. The dependent OFED modules resolve"
	echo "       their headers and Module.symvers through it and cannot build."
	exit 1
fi

# 2. everything else.
for pkg in ${OFED_KERNEL_PACKAGES}; do
	[ "${pkg}" = "mlnx-ofed-kernel" ] && continue
	if ! build_ofed_pkg ${pkg}; then
		echo "ERROR: failed to build ${pkg} for ${kernel}"
		exit 1
	fi
	install_ofed_debs ${OFED_BUILD_DIR}/build/${pkg} "${pkg}"
done

ex depmod -a ${kernel}

# openibd must load the freshly built MLNX_OFED modules.
if [ -e /etc/infiniband/openib.conf ]; then
	ex sed -i -e "s/FORCE_MODE=.*/FORCE_MODE=yes/" /etc/infiniband/openib.conf
fi

# VF interface-naming helpers. create_bfb copies these into the initramfs and
# does so unconditionally, so a missing file aborts the build.
#
# install.pl would place them via copy_udev_rules(), but that is unreachable
# here: it runs after an early `return 0` taken when --build-only is set, and it
# targets /etc/udev/rules.d rather than the /lib/udev/rules.d that create_bfb
# reads. mlnx-ofed-kernel-utils ships both files under examples/, so install
# them from there.
ofed_examples=/usr/share/doc/mlnx-ofed-kernel-utils/examples
if [ -d "${ofed_examples}" ]; then
	mkdir -p /etc/infiniband /lib/udev/rules.d
	if [ ! -e /etc/infiniband/vf-net-link-name.sh ]; then
		cp "${ofed_examples}/vf-net-link-name.sh" /etc/infiniband/
		chmod 755 /etc/infiniband/vf-net-link-name.sh
	fi
	if [ ! -e /lib/udev/rules.d/82-net-setup-link.rules ]; then
		cp "${ofed_examples}/82-net-setup-link.rules" /lib/udev/rules.d/
	fi
fi

for f in /etc/infiniband/vf-net-link-name.sh /lib/udev/rules.d/82-net-setup-link.rules; do
	if [ ! -e "$f" ]; then
		echo "ERROR: $f is missing and could not be installed from"
		echo "       ${ofed_examples}. create_bfb copies it into the initramfs"
		echo "       unconditionally and will fail."
		exit 1
	fi
done

# BlueField SoC drivers.
#
# NVIDIA publishes the SoC driver sources per DOCA release as .src.rpm under
# SOURCES/SoC/. Every kernel module among them is rebuilt here, whether or not
# the target kernel already provides a driver of the same name. The in-kernel
# copy is a snapshot of whatever the customer's kernel forked from; these are
# the versions this DOCA release was validated with. mlxbf-gige shows the gap
# plainly: the NVIDIA tree carries mlxbf_gige_uphy.c and mlxbf_gige_debug.c,
# neither of which is in mainline as of v6.16, and BF3 OOB networking needs
# the first. Rebuilt modules install into /lib/modules/<kernel>/updates, which
# depmod prefers over kernel/, so they take precedence over the in-box copy.
#
# Which sources are kernel modules is discovered, not hardcoded: a kernel
# module source carries debian/control.no_dkms, declaring the -modules package
# that WITH_DKMS=0 builds. The userspace sources (libpka, mlx-OpenIPMI,
# mlxbf-bootctl, rshim) do not. That keeps this loop right when a DOCA release
# adds or drops a driver.
#
# Best effort by design: a driver that will not build against this kernel is
# reported in the summary rather than failing the BFB. SOC_MODULES_SKIP takes
# a space separated list of package names to leave out.
if [ "X${BUILD_SOC_MODULES}" == "Xyes" ] && [ -n "${SOC_SRC_URL}" ]; then
	soc_built=""
	soc_failed=""
	soc_skipped=""
	soc_debs=""

	srpms=`wget -qO- "${SOC_SRC_URL}/" 2>/dev/null | grep -oE '[A-Za-z0-9._+-]+\.src\.rpm' | sort -u`
	if [ -z "${srpms}" ]; then
		echo "WARNING: no SoC sources found under ${SOC_SRC_URL}/"
	fi

	for srpm in ${srpms}; do
		rm -rf ${SOC_BUILD_DIR}/unpack
		mkdir -p ${SOC_BUILD_DIR}/unpack
		# .src.rpm is an rpm header plus a cpio payload holding the
		# source tarball and the spec. The spec's name is the package
		# name, which the tarball name carries a version suffix on.
		if ! ( set -e
			cd ${SOC_BUILD_DIR}/unpack
			wget -q "${SOC_SRC_URL}/${srpm}"
			rpm2cpio "${srpm}" | cpio -idm --quiet ); then
			echo "WARNING: could not unpack ${srpm}"
			soc_failed="${soc_failed} ${srpm}"
			continue
		fi

		spec=`/bin/ls -1 ${SOC_BUILD_DIR}/unpack/*.spec 2>/dev/null | head -1`
		[ -n "${spec}" ] || continue
		pkg=`basename "${spec}" .spec`

		tarball=`/bin/ls -1 ${SOC_BUILD_DIR}/unpack/${pkg}-*.tar.* 2>/dev/null | head -1`
		[ -n "${tarball}" ] || continue

		rm -rf ${SOC_BUILD_DIR}/${pkg}
		mkdir -p ${SOC_BUILD_DIR}/${pkg}
		tar xf "${tarball}" -C ${SOC_BUILD_DIR}/${pkg} || continue
		srcdir=`/bin/ls -1d ${SOC_BUILD_DIR}/${pkg}/*/ 2>/dev/null | head -1`
		[ -n "${srcdir}" ] || continue

		[ -e "${srcdir}/debian/control.no_dkms" ] || continue

		case " ${SOC_MODULES_SKIP} " in
			*" ${pkg} "*)
				echo "SoC: skipping ${pkg} on request"
				soc_skipped="${soc_skipped} ${pkg}"
				continue
				;;
		esac

		echo "SoC: building ${pkg} for ${kernel}"
		if ( set -e
			cd "${srcdir}"
			cp debian/control.no_dkms debian/control
			WITH_DKMS=0 KVER=${kernel} dpkg-buildpackage -us -uc -b ); then
			# The -modules package is not always named after the
			# source: tmfifo produces mlxbf-tmfifo-modules.
			built=`find ${SOC_BUILD_DIR}/${pkg} -maxdepth 2 -name '*-modules_*.deb' 2>/dev/null`
			if [ -n "${built}" ]; then
				soc_debs="${soc_debs} ${built}"
				soc_built="${soc_built} ${pkg}"
			else
				echo "WARNING: ${pkg} built but produced no -modules deb"
				soc_failed="${soc_failed} ${pkg}"
			fi
		else
			soc_failed="${soc_failed} ${pkg}"
		fi
	done

	if [ -n "${soc_debs}" ]; then
		echo "Installing rebuilt SoC modules:"
		echo ${soc_debs} | tr ' ' '\n' | sed -e 's|.*/|  |'
		dpkg -i --force-overwrite ${soc_debs} || apt install -y -f || true
		depmod -a ${kernel} || true
	fi

	echo "SoC modules built: ${soc_built:-none}"
	if [ -n "${soc_skipped}" ]; then
		echo "SoC modules skipped:${soc_skipped}"
	fi
	if [ -n "${soc_failed}" ]; then
		echo "WARNING: SoC modules that failed to build for ${kernel}:${soc_failed}"
		echo "WARNING: the BFB will not carry them. Add a package to"
		echo "WARNING: SOC_MODULES_SKIP to accept its absence, or enable whatever"
		echo "WARNING: the kernel config is missing and rebuild."
	fi
fi

# Guard: nothing built for a different kernel may ship in the BFB. Such modules
# would silently fail to load on the DPU, so fail the build loudly instead.
stale=$(dpkg-query -W -f='${Package} ${Version}\n' 2>/dev/null | grep 'kver\.' | grep -v "kver\.${kernel}\b" || true)
if [ -n "${stale}" ]; then
	echo "ERROR: packages built for a different kernel are installed:"
	echo "${stale}" | sed -e 's/^/  /'
	echo ""
	echo "These would not load on '${kernel}'. Either add them to the MLNX_OFED"
	echo "rebuild set, or prevent them from being installed in the Dockerfile."
	exit 1
fi

# Guard: create_bfb and install.sh both build their initramfs with a
# "modinfo <mod> || continue" loop, so a module that failed to build is dropped
# silently and only shows up as a broken DPU. Assert the ones this script is
# responsible for providing actually resolve against the target kernel.
missing=""
for mod in mst_pci mst_pciconf bf3_livefish mlx5_core mlx5_ib; do
	if ! (modinfo -k ${kernel} $mod > /dev/null 2>&1); then
		missing="$missing $mod"
	fi
done
if [ -n "${missing}" ]; then
	echo "ERROR: modules missing for kernel ${kernel}:${missing}"
	echo ""
	echo "These come from the OFED kernel packages built above, including"
	echo "kernel-mft (mst_pci, mst_pciconf, bf3_livefish). Without them the BFB"
	echo "would install and then fail on the DPU."
	exit 1
fi

# Advisory: create_bfb and install.sh both build their initramfs with a
# "modinfo <mod> || continue" loop, so anything unresolvable is dropped without
# a word. The SoC drivers are covered by the build summary above; what is left
# is the set create_bfb wants that neither MLNX_OFED nor the SoC sources can
# supply, so it has to come from the customer's kernel config.
advisory=""
for mod in nvme nvme-rdma nvme-tcp ib_ipoib ib_iser ib_umad mlxfw \
	dw_mmc dw_mmc-pltfm mmc_block sdhci 8021q \
	ipmi_devintf ipmi_ssif nls_iso8859-1 sbsa_gwdt
do
	if ! (modinfo -k ${kernel} $mod > /dev/null 2>&1); then
		advisory="$advisory $mod"
	fi
done
if [ -n "${advisory}" ]; then
	echo "WARNING: not provided by kernel ${kernel}:${advisory}"
	echo "WARNING: create_bfb will omit these from the installer initramfs."
fi

/usr/sbin/update-pciids || true

ex /root/workspace/create_bfb -k ${kernel}
